{
  "$defs": {
    "EmbeddingTarget": {
      "enum": [
        "paragraph",
        "sentence",
        "snippet"
      ],
      "title": "EmbeddingTarget",
      "type": "string"
    }
  },
  "$id": "newsrag/contracts/v1/Embedding",
  "additionalProperties": false,
  "description": "Interchange form of a vector. At rest, vectors live in the ANN engine's own format,\nkeyed by (target_kind, target_id, model_id). Article vectors are derived (mean of\nparagraph vectors) and never stored as Embedding rows.",
  "properties": {
    "dims": {
      "exclusiveMinimum": 0,
      "title": "Dims",
      "type": "integer"
    },
    "embedded_at": {
      "format": "date-time",
      "title": "Embedded At",
      "type": "string"
    },
    "model_id": {
      "description": "Exact model name and revision, e.g. 'BAAI/bge-small-en-v1.5@<sha>'.",
      "title": "Model Id",
      "type": "string"
    },
    "normalized": {
      "default": true,
      "title": "Normalized",
      "type": "boolean"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_kind": {
      "$ref": "#/$defs/EmbeddingTarget"
    },
    "vector": {
      "items": {
        "type": "number"
      },
      "title": "Vector",
      "type": "array"
    }
  },
  "required": [
    "target_kind",
    "target_id",
    "model_id",
    "dims",
    "vector",
    "embedded_at",
    "pipeline_version"
  ],
  "title": "Embedding",
  "type": "object",
  "x-stability": "provisional"
}
